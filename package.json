{
  "name": "incipe.dev",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "description": "This is my personal portfolio and blog site",
  "version": "0.0.1",
  "author": "Takafumi Asano <cariandrum22@gmail.com>",
  "dependencies": {
    "@astrojs/react": "^5.0.7",
    "@headlessui/react": "^2.2.4",
    "@heroicons/react": "^2.2.0",
    "@mdx-js/mdx": "^3.1.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/remove-markdown": "^0.3.4",
    "astro": "^7.1.0",
    "autoprefixer": "^10.4.21",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "katex": "^0.16.22",
    "lodash": "^4.18.1",
    "prismjs": "^1.30.0",
    "prop-types": "^15.8.1",
    "query-string": "^9.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rehype-katex": "^7.0.1",
    "rehype-prism-plus": "^2.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remove-markdown": "^0.6.2",
    "wrangler": "^4.25.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@eslint/js": "^9.39.4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.0.14",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0",
    "vitest": "^4.1.8"
  },
  "keywords": [
    "astro"
  ],
  "license": "Apache-2.0",
  "licenses": [
    {
      "type": "Apache-2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0"
    }
  ],
  "scripts": {
    "build": "astro build --config astro.config.mjs && node scripts/ensure-astro-routes.mjs",
    "build:astro": "astro build --config astro.config.mjs && node scripts/ensure-astro-routes.mjs",
    "check": "pnpm run check:static && pnpm run check:content && pnpm run build && pnpm run check:build-output",
    "check:build-output": "pnpm run check:routes:astro && pnpm run check:astro-head && pnpm run check:static-artifacts",
    "check:content": "node scripts/check-content.mjs",
    "check:astro-head": "node scripts/check-astro-head.mjs",
    "check:deployed-site": "node scripts/check-deployed-site.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:routes:astro": "node scripts/check-routes.mjs --output-dir dist",
    "check:static": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "check:static-artifacts": "node scripts/check-static-artifacts.mjs",
    "develop": "astro dev --config astro.config.mjs",
    "develop:astro": "astro dev --config astro.config.mjs",
    "format": "pnpm run format:eslint && pnpm run format:prettier",
    "format:prettier": "prettier --write \"**/*.{js,jsx,mjs,ts,tsx,json,md,yml,yaml}\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,mjs,ts,tsx,json,md,yml,yaml}\" \".github/**/*.{yml,yaml}\"",
    "format:eslint": "eslint --fix \"**/*.{js,jsx,mjs,ts,tsx}\"",
    "start": "astro dev --config astro.config.mjs",
    "serve": "astro preview --config astro.config.mjs",
    "clean": "rm -rf .astro .cache dist output",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cariandrum22/incipe.dev"
  },
  "bugs": {
    "url": "https://github.com/cariandrum22/incipe.dev/issues"
  }
}
